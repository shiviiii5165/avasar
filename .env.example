# Avsar environment — PLACEHOLDERS ONLY. Never commit real values.
# Avsar has its own infrastructure: never reuse AI Tathastu's or Collaborate's database, secrets or OAuth client.

# Public base URL of this deployment (no trailing slash)
AVSAR_PUBLIC_URL=http://localhost:3000

# PostgreSQL (Avsar's own database). Leave empty locally to use the embedded development database.
DATABASE_URL=
DATABASE_POOL_MAX=10

# 32+ random characters; signs short-lived document links. Required in production.
AVSAR_SIGNING_SECRET=

# ── AI Tathastu SSO: Avsar's OWN client registration (see docs/DECISIONS.md D-04) ──
AVSAR_AIT_BASE_URL=
AVSAR_AIT_CLIENT_ID=
AVSAR_AIT_CLIENT_SECRET=
# Must exactly match the redirect URI registered for Avsar's client
AVSAR_AIT_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Optional overrides (default to the documented integration endpoints under AVSAR_AIT_BASE_URL)
AVSAR_AIT_ISSUER=
AVSAR_AIT_AUTHORIZE_URL=
AVSAR_AIT_TOKEN_URL=
AVSAR_AIT_JWKS_URL=
AVSAR_AIT_PROFILE_URL=
AVSAR_AIT_SCOPES=openid profile email

# Comma-separated provider:subject pairs granted Super Admin on sign-in (bootstrap; audited)
AVSAR_BOOTSTRAP_SUPER_ADMINS=

# Development sign-in with synthetic personas. Ignored in production.
AVSAR_DEV_AUTH=0

# Email delivery adapter (HTTPS webhook to your provider). Empty = log only.
AVSAR_EMAIL_WEBHOOK_URL=
AVSAR_EMAIL_WEBHOOK_TOKEN=

# Release gates (off until their safety controls are verified)
AVSAR_FEATURE_EMPLOYER_PUBLISHING=0
