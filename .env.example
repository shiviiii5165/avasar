# Avsar environment — PLACEHOLDERS ONLY. Never commit real values.
# Avsar has its own infrastructure: never reuse AI Tathastu's or Collaborate's database, secrets or OAuth client.

# Public base URL of this deployment (no trailing slash)
AVSAR_PUBLIC_URL=http://localhost:3000

# PostgreSQL (Avsar's own database). Leave empty locally to use the embedded development database.
DATABASE_URL=
DATABASE_POOL_MAX=10

# 32+ random characters; signs short-lived document links. Required in production.
AVSAR_SIGNING_SECRET=

# ── AI Tathastu SSO: Avsar's OWN client registration (see docs/DECISIONS.md D-04) ──
AVSAR_AIT_BASE_URL=
AVSAR_AIT_CLIENT_ID=
AVSAR_AIT_CLIENT_SECRET=
# Optional. Defaults to {AVSAR_PUBLIC_URL}/api/auth/tathastu/callback (AI Tathastu's default path for apps).
# If set, it must EXACTLY match a URI in AI Tathastu's INTEGRATION_AVSAR_REDIRECT_URIS.
AVSAR_AIT_REDIRECT_URI=
# Optional overrides (default to the documented integration endpoints under AVSAR_AIT_BASE_URL)
# Defaults to https://www.aitathastu.com (the fixed issuer AI Tathastu signs with)
AVSAR_AIT_ISSUER=
AVSAR_AIT_AUTHORIZE_URL=
AVSAR_AIT_TOKEN_URL=
AVSAR_AIT_JWKS_URL=
AVSAR_AIT_PROFILE_URL=
# Not used: AI Tathastu ignores scope; students choose the shared sections on its consent screen.
AVSAR_AIT_SCOPES=

# Comma-separated provider:subject pairs granted Super Admin on sign-in (bootstrap; audited)
AVSAR_BOOTSTRAP_SUPER_ADMINS=

# Development sign-in with synthetic personas. Ignored in production.
AVSAR_DEV_AUTH=0

# Email delivery adapter (HTTPS endpoint of your provider/relay on a verified sending domain).
# Empty in development = messages are written to .data/outbox (nothing is sent). Required in production.
AVSAR_EMAIL_WEBHOOK_URL=
AVSAR_EMAIL_WEBHOOK_TOKEN=
AVSAR_EMAIL_FROM=Avsar <no-reply@your-verified-domain>

# Private document storage. Production must use an S3-compatible bucket (block all public access).
AVSAR_STORAGE_DRIVER=local
AVSAR_S3_BUCKET=
AVSAR_S3_REGION=
# Only for S3-compatible providers (R2, MinIO, ...); leave empty for AWS S3
AVSAR_S3_ENDPOINT=
# Credentials: use the host's IAM role, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the secret store

# Monitoring
# Error reports (JSON POST) to your monitoring/incident relay. Empty = structured logs only.
AVSAR_ERROR_WEBHOOK_URL=
# Lets your monitoring read /api/health details (missing settings, job counts). Random 32+ chars.
AVSAR_HEALTH_TOKEN=
# staging | production (labels error reports)
AVSAR_ENV=

# AI features. Default: built-in rules (no data leaves Avsar). Optional Claude provider:
AVSAR_AI_PROVIDER=rules
ANTHROPIC_API_KEY=
AVSAR_AI_MODEL=

# Release gates
# Employer Studio workspace (/studio). Always on in development; off in production until set to 1.
AVSAR_FEATURE_EMPLOYER_STUDIO=0
# Reserved: employer self-publishing stays off (Avsar staff approve and publish every listing).
AVSAR_FEATURE_EMPLOYER_PUBLISHING=0
